{
  "name": "basic-qwen-bonsai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "research:console": "python3 tools/research/cli.py console",
    "research:worker": "python3 tools/research/cli.py worker",
    "research:status": "python3 tools/research/cli.py status",
    "research:test": "python3 -m unittest discover -s tools/research -p 'test_*.py' -v",
    "research:models": "python3 tools/research/cli.py models",
    "research:reconcile": "python3 tools/research/cli.py reconcile",
    "research:check": "python3 -c \"from pathlib import Path; files=list(Path('tools/research').glob('*.py')); [compile(p.read_text(), str(p), 'exec') for p in files]; print('Python syntax checks passed')\"",
    "research:collaborate": "python3 tools/research/cli.py collaborate",
    "research:compare": "python3 tools/research/cli.py compare",
    "research:collaborations": "python3 tools/research/cli.py collaborations",
    "research:cancel-collaboration": "python3 tools/research/cli.py cancel-collaboration",
    "research:web": "python3 tools/research/web.py"
  }
}
