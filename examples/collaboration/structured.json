{
  "name": "Synthetic strict structured output",
  "instruction": "Revise the summary to be natural and concise; preserve project, storage and ordered steps exactly. Return a JSON artifact with only the four permitted fields. No new feature claims.",
  "source": {
    "project": "PebbleNotes",
    "storage": "on-device",
    "steps": [
      "Open app",
      "Write note",
      "Save note"
    ]
  },
  "original": {
    "project": "PebbleNotes",
    "storage": "on-device",
    "summary": "For the purposes of writing a note, this app provides the opportunity to write and save a note on this device.",
    "steps": [
      "Open app",
      "Write note",
      "Save note"
    ]
  },
  "format": "json",
  "requires_semantic_verification": false,
  "constraints": {
