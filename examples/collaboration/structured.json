          "const": "on-device"
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120
        },
        "steps": {
          "type": "array",
          "const": [
            "Open app",
            "Write note",
            "Save note"
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "allowed_numbers": [],
    "forbidden_content": [
      "sync",
      "encrypted",
      "guarantee"
    ]
  },
  "metrics": {
    "field": "summary",
    "avoid_phrases": [
      "for the purposes of",
      "provides the opportunity"
    ],
    "sentence_max_words": 16,
    "target_words": 12
  }
